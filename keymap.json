[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space a": "command_palette::Toggle",
      "space f": "workspace::Save",
      "ctrl-shift-space": "editor::ShowSignatureHelp",
      "space c a": "editor::ToggleCodeActions",
      "space r": "editor::Rename",
    },
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "L": "pane::ActivateNextItem",
      "H": "pane::ActivatePreviousItem",
      "space x": "pane::CloseActiveItem",
      "space s": "file_finder::Toggle",
      "ctrl-j": "workspace::ToggleBottomDock",
      "space e": "workspace::ToggleLeftDock",
      "] d": "editor::GoToDiagnostic",
      "space b c": "pane::CloseOtherItems",
      "space d s": "outline::Toggle",
      "space d w": "pane::DeploySearch",
      "space i j": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "!menu && vim_mode == insert",
    "bindings": {
      "ctrl-j": "editor::ShowSignatureHelp",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-k": "workspace::ToggleZoom",
      "f1": "workspace::NewTerminal",
      "alt-]": "tab_switcher::Toggle",
      "ctrl-n": null,
      "ctrl-p": null,
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space e": "workspace::ToggleLeftDock",
      "r": "project_panel::Rename",
    },
  },
]
